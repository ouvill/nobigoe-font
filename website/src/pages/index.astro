---
import marksData from "../../public/marks-data.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import ShapedText from "../components/ShapedText.astro";
import WeightSpecimen from "../components/WeightSpecimen.astro";
import { SITE } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const punctuationRows = [
  ["？？", "？？？"],
  ["！！", "！！！", "！！！！", "！！！！！"],
  ["？！", "！？"],
  ["？？！", "？！？", "！？？"],
  ["！！？", "！？！", "？！！"],
  ["！！？？", "？？！！"],
];
const koburiCompatibleMarks = marksData.filter(
  (mark) => mark.koburiPua && mark.script !== "symbol",
);
if (koburiCompatibleMarks.length !== 88) {
  throw new Error(
    `Expected 88 Koburi-compatible kana, found ${koburiCompatibleMarks.length}`,
  );
}
const koburiMarkGroups = [
  koburiCompatibleMarks.filter(
    (mark) => mark.script === "hiragana" && mark.type === "dakuten",
  ),
  koburiCompatibleMarks.filter(
    (mark) => mark.script === "katakana" && mark.type === "dakuten",
  ),
  koburiCompatibleMarks.filter((mark) => mark.type === "handakuten"),
];
---

<BaseLayout pageClass="home-page">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-overline">
        <span>GENERAL-PURPOSE JAPANESE SERIF</span>
        <span>Version {SITE.version}</span>
      </p>
      <h1 id="hero-title">
        <span>文章も、</span>
        <span>声の表情も。</span>
      </h1>
      <p class="hero-description">
        のびごえ明朝は、Noto Serif
        JPを土台にした一般用途の明朝体です。本文を読みやすく組める文字を揃えながら、長く伸びる記号、濁点・半濁点、感嘆符や疑問符まで、声のような文字表現を加えました。
      </p>
      <div class="hero-actions">
        <a class="button button--solid" href={`${base}/#try`}>文字を試す</a>
        <a class="button button--line" href={`${base}/#download`}
          >無料ダウンロード ↓</a
        >
      </div>
      <p class="hero-license">
        7ウェイト · 横組／縦組 · SIL Open Font License 1.1
      </p>
    </div>

    <div class="hero-specimen" aria-label="のびごえ明朝でできる文字表現の見本">
      <p class="hero-specimen-index">NOBIGOE IN ACTION</p>
      <div class="hero-voice hero-voice--long">
        <span>伸ばす</span>
        <strong>
          <ShapedText
            class="shaped-text"
            text="待ってーーーー！"
            label="待ってに続いて長くつながる長音と感嘆符"
          />
        </strong>
      </div>
      <div class="hero-voice hero-voice--wave">
        <span>揺らす</span>
        <strong>
          <ShapedText
            class="shaped-text"
            text="ざわ〜〜〜〜〜"
            label="ざわに続いて長くつながる波ダッシュ"
          />
        </strong>
      </div>
      <div class="hero-voice hero-voice--mark">
        <span>濁らせる</span>
        <strong>
          <ShapedText
            class="shaped-text"
            text="あ゙っ！！？"
            label="濁点付きのあ、小さいつ、感嘆符二つと疑問符の合字"
          />
        </strong>
      </div>
      <p class="hero-specimen-note">
        同じフォント、同じ文字入力から。OpenType機能で自動的に組み替わります。
      </p>
    </div>

    <nav class="capability-nav" aria-label="できること">
      <a href="#extend"
        ><span>01</span><strong>記号を伸ばす</strong><small
          >4種類・縦横対応</small
        ></a
      >
      <a href="#marks"
        ><span>02</span><strong>濁点を足す</strong><small>198の結合字形</small
        ></a
      >
      <a href="#punctuation"
        ><span>03</span><strong>約物をたたむ</strong><small>16組の合字</small
        ></a
      >
      <a href="#families"
        ><span>04</span><strong>文章を組む</strong><small
          >2書体・7ウェイト</small
        ></a
      >
    </nav>
  </section>

  <section class="positioning-section" aria-label="書体について">
    <p class="section-index">まず知ってほしいこと</p>
    <div class="positioning-copy">
      <div>
        <p>
          Noto Serif JP由来の和文とLibertinus
          Serifの欧文を組み合わせ、見出し、本文、ウェブ、印刷物まで広く使える設計です。特徴的な記号は、セリフや擬音の表現にも役立ちます。
        </p>
        <p>
          必要なときだけ、OpenType機能が声のニュアンスを加えます。普段は端正な明朝体として、表現したい場面では一歩先まで。
        </p>
      </div>
    </div>
    <dl class="positioning-facts">
      <div>
        <dt>和文</dt><dd>Noto Serif JP</dd><small
          >広い文字収録を持つ本文の土台</small
        >
      </div>
      <div>
        <dt>欧文</dt><dd>Libertinus Serif</dd><small
          >和文の濃さへ合わせた欧文</small
        >
      </div>
      <div>
        <dt>用途</dt><dd>General purpose</dd><small
          >本文・見出し・ウェブ・印刷</small
        >
      </div>
    </dl>
  </section>

  <section
    class="feature-section feature-section--extend"
    id="extend"
    aria-labelledby="extend-title"
  >
    <header class="feature-heading">
      <p><span>01</span> EXTEND</p>
      <h2 id="extend-title">記号をつなげて、<br />好きな長さに。</h2>
      <p>
        同じ記号を2文字以上続けると、始端・中間・終端の字形へ自動で置き換わります。長さを先に決める必要はありません。
      </p>
    </header>

    <div class="extension-board">
      <article>
        <header><span>長音</span><code>ー U+30FC</code></header>
        <p>
          <ShapedText
            class="shaped-text"
            text="まだーーーーーー"
            label="まだに続く6文字のつながった長音"
          />
        </p>
        <small>セリフ、語尾、呼びかけをまっすぐ伸ばす</small>
      </article>
      <article>
        <header><span>HORIZONTAL BAR</span><code>― U+2015</code></header>
        <p>
          <ShapedText
            class="shaped-text"
            text="遠くへ―――――"
            label="遠くへに続く5文字のつながった水平線"
          />
        </p>
        <small>区切りや長いダッシュを一本の線にする</small>
      </article>
      <article class="extension-board__accent">
        <header>
          <span>波ダッシュ</span><code>〜 U+301C ／ ～ U+FF5E</code>
        </header>
        <p>
          <ShapedText
            class="shaped-text"
            text="ゆらり〜〜〜〜〜"
            label="ゆらりに続く5文字のつながった波ダッシュ"
          />
        </p>
        <small>全角チルダ「～」でも同じ波形を使えます</small>
      </article>
      <article>
        <header><span>WAVY DASH</span><code>〰 U+3030</code></header>
        <p>
          <ShapedText
            class="shaped-text"
            text="水面〰〰〰〰〰"
            label="水面に続く5文字のつながった細かな波線"
          />
        </p>
        <small>細かな波を連ねて、揺れや余韻をつくる</small>
      </article>
    </div>

    <div class="feature-note">
      <strong>横組でも、縦組でも。</strong>
      <p>
        4種類すべてに縦組用の字形があります。一般的なシェーピングエンジンでは有効ですが、利用アプリがOpenTypeの「前後関係に依存する字形（calt）」に対応している必要があります。
      </p>
    </div>
  </section>

  <section
    class="feature-section feature-section--marks"
    id="marks"
    aria-labelledby="marks-title"
  >
    <header class="feature-heading feature-heading--light">
      <p><span>02</span> COMBINE</p>
      <h2 id="marks-title">仮名に濁点を。<br />半濁点も。</h2>
      <p>
        基本の文字と結合濁点・結合半濁点を入力すると、一体になった字形へ置き換わります。辞書にない声、方言、発音のニュアンスも文字にできます。
      </p>
    </header>

    <div class="marks-showcase">
      <div class="marks-stage">
        <p class="marks-stage__label">
          源暎こぶり明朝互換 / 濁点・半濁点付き仮名 88字形
        </p>
        <div
          class="marks-stage__glyphs"
          role="img"
          aria-label="源暎こぶり明朝互換の濁点・半濁点付き仮名88字形"
        >
          {
            koburiMarkGroups.map((group) => (
              <div class="marks-stage__glyph-group" aria-hidden="true">
                {group.map((mark) => (
                  <span>{mark.glyph}</span>
                ))}
              </div>
            ))
          }
        </div>
        <p class="marks-stage__symbols">
          <ShapedText
            class="shaped-text"
            text="ー゙　♡゙　♥゙　！゙　！゚　？゙　？゚"
            label="濁点が付いた長音、白ハート、黒ハートと、濁点・半濁点が付いた感嘆符、疑問符"
          />
        </p>
      </div>
      <div class="marks-details">
        <article>
          <strong>191</strong><h3>仮名の組み合わせ</h3><p>
            ひらがな、カタカナ、小書き仮名などをAdobe-Manga1-0の対象列に沿って収録。
          </p>
        </article>
        <article>
          <strong>+ 7</strong><h3>長音・ハート・約物</h3><p>
            長音とハートの濁点3字形、感嘆符・疑問符の濁点・半濁点4字形も使えます。
          </p>
        </article>
        <article>
          <strong>88</strong><h3>互換用の直接入力</h3><p>
            源暎こぶり明朝互換の88字形は、私用領域U+E082–U+E0D9からも入力できます。
          </p>
        </article>
      </div>
    </div>

    <a class="text-link" href={`${base}/glyphs/`}>198字形を一覧で探す →</a>
  </section>

  <section
    class="feature-section feature-section--punctuation"
    id="punctuation"
    aria-labelledby="punctuation-title"
  >
    <header class="feature-heading">
      <p><span>03</span> EMPHASIZE</p>
      <h2 id="punctuation-title">
        「！」「？」を、<br />一文字ぶんに。
      </h2>
      <p>
        全角の感嘆符と疑問符を2〜5文字続けるだけ。対応する16通りの並びを全角一文字幅へまとめ、文章のリズムを崩さず強調できます。
      </p>
    </header>

    <div
      class="punctuation-comparison"
      aria-label="感嘆符と疑問符の16通りの合字を明朝と回転字形で比較"
    >
      {
        [
          {
            id: "punctuation-mincho",
            name: "明朝",
            feature: "ccmp",
            className: "punctuation-specimen--mincho",
          },
          {
            id: "punctuation-mincho-rotated",
            name: "回転字形",
            feature: "ccmp + ss01",
            className: "punctuation-specimen--mincho-rotated",
          },
        ].map((variant) => (
          <section
            class={`punctuation-specimen ${variant.className}`}
            aria-labelledby={variant.id}
          >
            <header>
              <h3 id={variant.id}>{variant.name}</h3>
              <p>{variant.feature}</p>
            </header>
            <ul aria-label={`${variant.name}の16通り`}>
              {punctuationRows.map((row) => (
                <li>
                  {row.map((sequence) => (
                    <span>{sequence}</span>
                  ))}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section
    class="families-section"
    id="families"
    aria-labelledby="families-title"
  >
    <header class="section-heading">
      <p class="section-index">04 / TYPESETTING</p>
      <h2 id="families-title">
        表現だけでなく、<br />ふつうの文章も。
      </h2>
      <p>
        表示用の特殊な字形だけを集めたフォントではありません。用途と読み心地に合わせて、二つの本文書体から選べます。
      </p>
    </header>

    <div class="family-cards">
      <article class="family-card family-card--standard">
        <p>STANDARD FAMILY / 7 WEIGHTS</p>
        <h3>のびごえ明朝</h3>
        <p class="family-card__sample">言葉の輪郭を、静かに整える。</p>
        <p>
          Noto Serif JPの和文とLibertinus
          Serifの欧文を組み合わせた標準ファミリー。細い本文から強い見出しまで、7段階の太さで組めます。
        </p>
        <dl>
          <div><dt>和文</dt><dd>Noto Serif JP</dd></div><div>
            <dt>形式</dt><dd>OpenType / CFF</dd>
          </div>
        </dl>
      </article>
      <article class="family-card family-card--koburi">
        <p>READING FAMILY / REGULAR</p>
        <h3>のびごえこぶり明朝</h3>
        <p class="family-card__sample">雨の音が、遠くの屋根を渡っていた。</p>
        <p>
          源暎こぶり明朝を土台にした本文ファミリー。小ぶりな仮名が漢字との間に抑揚をつくり、小説や長文、縦組をゆったり見せます。
        </p>
        <dl>
          <div><dt>和文</dt><dd>源暎こぶり明朝</dd></div><div>
            <dt>形式</dt><dd>TrueType</dd>
          </div>
        </dl>
      </article>
    </div>

    <div class="weight-area">
      <header>
        <p>7 WEIGHTS</p>
        <h3>見出しから本文まで、同じ声で。</h3>
        <span>ExtraLight 200 — Black 900</span>
      </header>
      <WeightSpecimen />
    </div>

    <div class="vertical-area">
      <div class="vertical-copy">
        <p>HORIZONTAL / VERTICAL</p>
        <h3>横組と縦組、どちらにも。</h3>
        <p>
          伸長記号と濁点・半濁点付き仮名は縦組にも対応。ウェブの本文から小説、電子書籍、印刷物まで使えます。
        </p>
        <a
          class="text-link"
          href={`${base}/nobigoe-mincho-vertical-specimen.pdf`}
          >縦組PDF見本を見る →</a
        >
      </div>
      <figure class="vertical-specimen">
        <p>
          雨の音が、遠くの屋根を静かに渡っていた。<br /><span
            >「待ってーーーー」。</span
          ><br />呼び声は夜の奥へ細く伸び、やがて風の気配に溶けていく。
        </p>
        <figcaption>のびごえこぶり明朝 Regular / 縦組</figcaption>
      </figure>
    </div>
  </section>

  <section class="try-section" id="try" aria-labelledby="try-title">
    <header>
      <p>TRY NOBIGOE MINCHO</p>
      <h2 id="try-title">のびごえ明朝を試す</h2>
    </header>
    <div class="try-panel">
      <div class="try-field">
        <label for="font-try-input">試したい文章を入力</label>
        <input
          id="font-try-input"
          type="text"
          maxlength="50"
          placeholder="待ってーーーー！ 声はどこまでも伸びていく。"
          autocomplete="off"
          spellcheck="false"
          data-font-try-input
        />
      </div>
      <div class="try-preview">
        <div class="try-preview-meta">
          <span>PREVIEW / NOBIGOE MINCHO REGULAR</span>
          <a href={`${base}/glyphs/`}>198字形を見る →</a>
        </div>
        <output for="font-try-input" data-font-try-output
          >待ってーーーー！ 声はどこまでも伸びていく。</output
        >
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>(
      "[data-font-try-input]",
    );
    const output = document.querySelector<HTMLOutputElement>(
      "[data-font-try-output]",
    );

    if (input && output) {
      const sample = input.placeholder;
      const updatePreview = () => {
        output.textContent = input.value || sample;
      };

      input.addEventListener("input", updatePreview);
      updatePreview();
    }
  </script>

  <section
    class="download-section"
    id="download"
    aria-labelledby="download-title"
  >
    <div class="download-copy">
      <p class="download-eyebrow">OPEN SOURCE / SIL OFL 1.1</p>
      <h2 id="download-title">
        3つの書体から、<br />用途に合わせて。
      </h2>
      <p class="download-intro">
        本文・見出し向け、小説・長文向け、好きな書体に伸長記号だけを足す版を用意しています。
      </p>
    </div>
    <div class="package-list">
      <article>
        <div class="package-copy">
          <span>7 WEIGHTS · OPENTYPE/CFF</span>
          <h3>のびごえ明朝</h3>
          <p>
            本文・見出し・ウェブ・印刷物に。7ウェイトを収録した標準ファミリーです。
          </p>
        </div>
        <div class="package-action">
          <code>NobigoeMincho-v{SITE.version}.zip</code>
          <a class="button button--paper" href={SITE.downloadUrl}
            >ダウンロード ↓</a
          >
        </div>
      </article>
      <article>
        <div class="package-copy">
          <span>REGULAR · TRUETYPE</span>
          <h3>のびごえこぶり明朝</h3>
          <p>
            小ぶりな仮名を生かした本文向け。小説・長文・縦組をゆったり見せます。
          </p>
        </div>
        <div class="package-action">
          <code>NobigoeKoburiMincho-v{SITE.version}.zip</code>
          <a class="button button--paper-line" href={SITE.koburiDownloadUrl}
            >ダウンロード ↓</a
          >
        </div>
      </article>
      <article>
        <div class="package-copy">
          <span>5 CHARACTERS · VARIABLE OPENTYPE/CFF2</span>
          <h3>のびごえエッセンシャル</h3>
          <p>
            好きな本文フォントはそのままに、5つの伸長記号だけを加える可変フォントです。
          </p>
        </div>
        <div class="package-action">
          <code>NobigoeEssential-v{SITE.version}.zip</code>
          <a class="button button--paper-line" href={SITE.essentialDownloadUrl}
            >ダウンロード ↓</a
          >
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
