---
import GlyphCatalog from "../components/GlyphCatalog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`全194字形 — ${SITE.name}`}
  description="濁点・半濁点付き仮名と記号を、二つの書体と7ウェイトで比較できます。"
  pageClass="tool-page glyph-page"
>
  <section class="page-hero page-hero--glyphs">
    <p class="page-index">収録字形</p>
    <h1>濁点・半濁点の<br />全194字形</h1>
    <p>
      見たい字形を、濁点の種類・文字種・書体・太さで絞り込めます。「外」「小」「縦」の表示は、外字・小書き仮名・縦組専用字形を表します。
    </p>
  </section>
  <GlyphCatalog />
  <aside class="next-page">
    <p>文章の中で試す</p>
    <a href={`${base}/tester/`}
      >文字テスターへ <span aria-hidden="true">→</span></a
    >
  </aside>
</BaseLayout>
