<section class="tester-app" aria-label="文字テスター">
  <header class="tester-introduction">
    <p>使い方</p>
    <h2>例文を選び、<br />書体と組み方を切り替えて比較します。</h2>
    <p>
      黒い試字欄は直接編集できます。まずは下の三つの例文から選んでください。
    </p>
  </header>

  <aside class="tester-browser-note">
    この試字欄はブラウザのOpenType実装で描画します。長音や波線がつながらない場合は、
    <a href="/#capability-title">トップページの固定見本</a>
    または縦組みPDFで正しい字形をご確認ください。
  </aside>

  <div class="tester-samples" aria-label="例文を選択">
    <strong>1. 表示する内容</strong>
    <button
      class="is-active"
      type="button"
      data-sample="余韻ーーーーーー\n水面に波紋が〜〜〜\n静かな線が続いていく。"
      data-sample-family="nobigoe"
      data-sample-writing="horizontal"
      aria-pressed="true">長音と波ダッシュ</button
    >
    <button
      type="button"
      data-sample="が　き゚　く゚　け゚　こ゚\nガ　キ゚　ク゚　ケ゚　コ゚\nー゙　♡゙　♥゙\n！゙　！゚　？゙　？゚"
      data-sample-family="nobigoe"
      data-sample-writing="horizontal"
      aria-pressed="false">濁点・半濁点</button
    >
    <button
      type="button"
      data-sample="雨の音が、遠くの屋根を静かに渡っていた。\n「待ってーーーー」。\n呼び声は夜の奥へ伸びていく。"
      data-sample-family="koburi"
      data-sample-writing="vertical"
      aria-pressed="false">小説（縦組）</button
    >
  </div>

  <div class="tester-panel">
    <fieldset class="control">
      <legend>2. 書体</legend>
      <div class="choice-group" data-tester-families>
        <button
          class="is-active"
          type="button"
          data-family="nobigoe"
          aria-pressed="true">のびごえ明朝</button
        >
        <button type="button" data-family="koburi" aria-pressed="false"
          >のびごえこぶり明朝</button
        >
      </div>
    </fieldset>

    <fieldset class="control">
      <legend>3. 組み方</legend>
      <div class="choice-group" data-writing-modes>
        <button
          class="is-active"
          type="button"
          data-writing="horizontal"
          aria-pressed="true">横組</button
        >
        <button type="button" data-writing="vertical" aria-pressed="false"
          >縦組</button
        >
      </div>
    </fieldset>

    <div class="control control--size">
      <label for="font-size">4. 文字サイズ</label>
      <output id="font-size-value" for="font-size">64 px</output>
      <input id="font-size" type="range" min="28" max="128" value="64" />
    </div>
  </div>

  <details class="tester-advanced">
    <summary>感嘆符・疑問符の字形を変更する</summary>
    <div>
      <fieldset class="control">
        <legend>「！？」「？？」の書体</legend>
        <p>連続する感嘆符・疑問符だけに適用します。</p>
        <div class="choice-group" data-punctuation-styles>
          <button
            class="is-active"
            type="button"
            data-feature=""
            aria-pressed="true">明朝</button
          >
          <button type="button" data-feature="ss01" aria-pressed="false"
            >斜体明朝</button
          >
        </div>
      </fieldset>
    </div>
  </details>

  <div
    class="tester-workspace"
    data-tester-canvas
    data-family="nobigoe"
    aria-label="のびごえ明朝の試字欄"
  >
    <div
      class="tester-editor"
      id="tester-text"
      contenteditable="true"
      role="textbox"
      aria-multiline="true"
      spellcheck="false"
    >
      余韻ーーーーーー 水面に波紋が〜〜〜 風が、静かに続いていく。
    </div>
    <p class="tester-hint">ここをクリックして文章を編集できます</p>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLElement>("[data-tester-canvas]");

  if (canvas) {
    const editor = canvas.querySelector<HTMLElement>("#tester-text")!;
    const size = document.querySelector<HTMLInputElement>("#font-size")!;
    const sizeValue =
      document.querySelector<HTMLOutputElement>("#font-size-value")!;
    const familyButtons = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-tester-families] button",
      ),
    ];
    const writingButtons = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-writing-modes] button",
      ),
    ];
    const punctuationButtons = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-punctuation-styles] button",
      ),
    ];
    const sampleButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-sample]"),
    ];
    let punctuation = "";

    const activate = (
      buttons: HTMLButtonElement[],
      activeButton: HTMLButtonElement,
    ) => {
      for (const button of buttons) {
        const active = button === activeButton;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      }
    };

    const updateFeatures = () => {
      const features = [
        '"ccmp" 1',
        '"calt" 1',
        punctuation && `"${punctuation}" 1`,
      ].filter(Boolean);
      editor.style.fontFeatureSettings = features.join(", ");
    };

    size.addEventListener("input", () => {
      sizeValue.value = `${size.value} px`;
      editor.style.fontSize = `${size.value}px`;
    });

    for (const button of familyButtons) {
      button.addEventListener("click", () => {
        const koburi = button.dataset.family === "koburi";
        canvas.dataset.family = koburi ? "koburi" : "nobigoe";
        canvas.setAttribute(
          "aria-label",
          `${koburi ? "のびごえこぶり明朝" : "のびごえ明朝"}の試字欄`,
        );
        activate(familyButtons, button);
        document.fonts.load(
          `${size.value}px "${koburi ? "Nobigoe Koburi" : "Nobigoe"}"`,
          editor.textContent || "",
        );
      });
    }

    for (const button of writingButtons) {
      button.addEventListener("click", () => {
        canvas.classList.toggle(
          "is-vertical",
          button.dataset.writing === "vertical",
        );
        activate(writingButtons, button);
        updateFeatures();
      });
    }

    for (const button of punctuationButtons) {
      button.addEventListener("click", () => {
        punctuation = button.dataset.feature || "";
        activate(punctuationButtons, button);
        updateFeatures();
      });
    }

    for (const button of sampleButtons) {
      button.addEventListener("click", () => {
        editor.textContent = button.dataset.sample!.replaceAll("\\n", "\n");
        activate(sampleButtons, button);
        familyButtons
          .find(
            (candidate) =>
              candidate.dataset.family === button.dataset.sampleFamily,
          )
          ?.click();
        writingButtons
          .find(
            (candidate) =>
              candidate.dataset.writing === button.dataset.sampleWriting,
          )
          ?.click();
        editor.focus();
      });
    }
  }
</script>
