---
import { NAVIGATION, SITE } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const toPath = (href: string) => (href === "/" ? `${base}/` : `${base}${href}`);
const isActive = (href: string) => {
  const target = toPath(href);
  return href === "/" ? currentPath === target : currentPath.startsWith(target);
};
---

<header class="site-header">
  <a
    class="brand"
    href={toPath("/")}
    aria-label={`${SITE.name}・${SITE.companion} トップへ`}
  >
    <span class="brand-mark" aria-hidden="true">の</span>
    <span class="brand-name">
      <strong>{SITE.name}</strong>
      <small>＋ {SITE.companion}</small>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="メインナビゲーション">
    {
      NAVIGATION.map((item) => (
        <a
          href={toPath(item.href)}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="header-release" href={SITE.releaseUrl}>
    <span>ダウンロード</span><span aria-hidden="true">↗</span>
  </a>

  <details class="mobile-nav">
    <summary><span>メニュー</span><span aria-hidden="true">＋</span></summary>
    <nav aria-label="モバイルナビゲーション">
      {
        NAVIGATION.map((item) => (
          <a
            href={toPath(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={SITE.releaseUrl}>GitHub Releases ↗</a>
    </nav>
  </details>
</header>
